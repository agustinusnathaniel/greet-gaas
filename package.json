{
  "name": "greeting-gaas",
  "version": "1.0.1",
  "private": true,
  "author": "agustinusnathaniel",
  "engines": {
    "node": "^24.11.x"
  },
  "packageManager": "pnpm@12.4.2",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "turbo": "pnpm dlx turbo@2.6.3",
    "build:turbo": "pnpm turbo build",
    "postbuild": "next-sitemap --config next-sitemap.config.js",
    "biome:check": "biome check --no-errors-on-unmatched --error-on-warnings",
    "biome:fix": "pnpm biome:check --write",
    "biome:ci": "biome ci",
    "type:check": "tsc --noEmit",
    "check:turbo": "pnpm turbo run biome:check type:check",
    "start": "next start",
    "format": "prettier --write src",
    "up-interactive": "pnpm up -i",
    "up-latest": "pnpm up-interactive -L",
    "release": "standard-version",
    "push-release": "git push --follow-tags origin main",
    "prepare": "husky install"
  },
  "dependencies": {
    "@chakra-ui/react": "3.37.0",
    "@emotion/react": "^11.14.0",
    "@hookform/resolvers": "^5.9.1",
    "@types/crypto-js": "^4.2.2",
    "crypto-js": "^4.2.0",
    "ky": "2.1.0",
    "motion": "13.4.0",
    "next": "^16.3.5",
    "next-themes": "0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.88.0",
    "react-icons": "^5.7.0",
    "react-wrap-balancer": "^1.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "next-sitemap": "^4.2.3",
    "standard-version": "^9.5.0",
    "typescript": "^7.0.2"
  }
}
